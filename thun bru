
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Selamat Tahun Baru 2027</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: linear-gradient(135deg, #05051c, #17104a, #38004d);
    color: white;
    font-family: Arial, sans-serif;
    text-align: center;
    min-height: 100vh;
    overflow: hidden;
}

.container {
    position: relative;
    z-index: 2;
    padding: 100px 20px;
}

h1 {
    font-size: clamp(35px, 8vw, 65px);
    color: gold;
    text-shadow: 0 0 20px orange;
    animation: glow 2s infinite alternate;
}

h2 {
    font-size: 30px;
    margin: 20px;
}

p {
    font-size: 18px;
    line-height: 1.7;
}

#countdown {
    font-size: 30px;
    color: #00ffff;
    margin: 30px;
    font-weight: bold;
}

button {
    background: gold;
    color: #222;
    padding: 15px 30px;
    border: none;
    border-radius: 30px;
    font-size: 18px;
    cursor: pointer;
    margin-top: 25px;
}

button:hover {
    background: orange;
    transform: scale(1.1);
}

@keyframes glow {
    from { text-shadow: 0 0 10px gold; }
    to { text-shadow: 0 0 35px orange, 0 0 60px red; }
}

canvas {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
}
</style>
</head>

<body>

<canvas id="fireworks"></canvas>

<div class="container">
    <h1>🎆 HAPPY NEW YEAR 🎆</h1>

    <h2>SELAMAT TAHUN BARU 2027</h2>

    <p>
        🇮🇩 Mari Sambut Tahun Baru Nasional! 🇮🇩
        <br>
        Semoga tahun yang baru membawa kebahagiaan,
        kesuksesan, kedamaian, dan harapan baru.
        <br><br>
        Bersama kita bangun Indonesia yang lebih baik!
    </p>

    <div id="countdown">Menghitung waktu...</div>

    <button onclick="mulaiPesta()">
        🎉 RAYAKAN SEKARANG 🎉
    </button>
</div>

<script>
const countdown = document.getElementById("countdown");

function hitungMundur() {
    const target = new Date("January 1, 2027 00:00:00").getTime();
    const sekarang = new Date().getTime();
    const selisih = target - sekarang;

    if (selisih <= 0) {
        countdown.innerHTML = "🎆 SELAMAT TAHUN BARU 2027! 🎆";
        return;
    }

    const hari = Math.floor(selisih / (1000 * 60 * 60 * 24));
    const jam = Math.floor((selisih / (1000 * 60 * 60)) % 24);
    const menit = Math.floor((selisih / (1000 * 60)) % 60);
    const detik = Math.floor((selisih / 1000) % 60);

    countdown.innerHTML =
        `${hari} Hari ${jam} Jam ${menit} Menit ${detik} Detik`;
}

setInterval(hitungMundur, 1000);
hitungMundur();

// ANIMASI KEMBANG API
const canvas = document.getElementById("fireworks");
const ctx = canvas.getContext("2d");

canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

let particles = [];

function buatKembangApi(x, y) {
    const warna = `hsl(${Math.random() * 360},100%,60%)`;

    for (let i = 0; i < 80; i++) {
        const sudut = Math.random() * Math.PI * 2;
        const kecepatan = Math.random() * 5 + 1;

        particles.push({
            x: x,
            y: y,
            dx: Math.cos(sudut) * kecepatan,
            dy: Math.sin(sudut) * kecepatan,
            hidup: 100,
            warna: warna
        });
    }
}

function animasi() {
    ctx.fillStyle = "rgba(5,5,28,0.2)";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    particles.forEach((p, i) => {
        p.x += p.dx;
        p.y += p.dy;
        p.dy += 0.03;
        p.hidup--;

        ctx.beginPath();
        ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
        ctx.fillStyle = p.warna;
        ctx.fill();

        if (p.hidup <= 0) {
            particles.splice(i, 1);
        }
    });

    requestAnimationFrame(animasi);
}

animasi();

function mulaiPesta() {
    for (let i = 0; i < 8; i++) {
        setTimeout(() => {
            buatKembangApi(
                Math.random() * canvas.width,
                Math.random() * canvas.height * 0.7
            );
        }, i * 300);
    }

    alert("🎉 SELAMAT TAHUN BARU 2027! 🎉");
}

setInterval(() => {
    buatKembangApi(
        Math.random() * canvas.width,
        Math.random() * canvas.height * 0.6
    );
}, 1000);

window.addEventListener("resize", () => {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
});
</script>

</body>
</html>
